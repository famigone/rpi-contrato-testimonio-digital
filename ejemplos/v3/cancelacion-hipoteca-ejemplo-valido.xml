          <PEP>false</PEP>
        </Parte>
      </Partes>

      <Inmuebles>
        <Inmueble>
          <!-- SIN CertificacionCatastral ni NomenclaturaCatastral: la cancelación
               no las lleva. Esto es lo que v2 rechazaba y v3 habilita. -->
