        <!-- El deudor liberado → rol DEUDOR (va a wmt). SIN CertificacionInhibicion:
             la familia LIBERA no la exige (no grava nada nuevo). -->
        <Parte rol="DEUDOR">
          <Tipo>H</Tipo>
          <ApellidoODenominacion>ROMERO</ApellidoODenominacion>
          <Nombres>CARLA VANESA</Nombres>
